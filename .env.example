# Copy this file to .env for local development. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///mindbloom.db
# Local AI service while testing on this computer:
AI_MODEL_URL=http://127.0.0.1:7860/chat
AI_SERVICE_TOKEN=replace-with-the-same-long-random-token-used-in-ai_service/.env
# Optional only. Leave blank to use the self-hosted AI service and local fallback.
GEMINI_API_KEY=
